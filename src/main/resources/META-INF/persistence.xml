<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.0" xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">
    <!--
        As tabelas são criadas pelo Flyway (src/main/resources/db/migration).
        Por isso não há propriedades de geração de schema aqui.
    -->
    <persistence-unit name="todolistPU" transaction-type="JTA">
        <jta-data-source>java:app/jdbc/todolist</jta-data-source>
        <exclude-unlisted-classes>false</exclude-unlisted-classes>
    </persistence-unit>
</persistence>
